# ----------------------------------------------------------------------------
# Dell Hackathon 2026 - Problem Statement 1
# Environment Configuration Template
# ----------------------------------------------------------------------------

# Google Gemini API Key (Optional for live LLM mode; system runs self-contained out of the box)
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding Model Identifier (Runs locally via sentence-transformers or self-contained engine)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Persistent Vector Database Directory
CHROMA_DB_PATH=./chroma_db

# Similarity Guardrail Threshold (Queries below this threshold trigger safe refusal)
SIMILARITY_THRESHOLD=0.35

# Server Port for Streamlit Web UI
PORT=8501

